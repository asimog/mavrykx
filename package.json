{
  "name": "mavrykx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "npm run build --workspace @mavrykx/desktop",
    "depcruise": "depcruise apps/desktop/src",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.node.json && tsc --noEmit -p apps/desktop/tsconfig.web.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
